# ============================================================
# CBT LOCAL SERVER - exam hall machine (development)
# The installed Windows app stores these in C:\ProgramData\CBT\config.json.
# Copy to `.env` only for local development. Never commit `.env`.
# ============================================================

# ---- LOCAL STORAGE -----------------------------------------
# Override only when developing. The installed service uses C:\ProgramData\CBT.
# CBT_DATA_DIR="C:/ProgramData/CBT"

# A plain SQLite file. The default lives under CBT_DATA_DIR.
# LOCAL_DATABASE_URL="file:./exam-hall.db"

# ---- CLOUD CONNECTION (pairing, pull, push) -----------------
# The deployed cloud API. Unreachable on exam day by design - pull happens before,
# push happens after. The setup wizard can also store this value in config.json.
CLOUD_BASE_URL="http://localhost:3000"

# Optional development override. The normal flow mints this key during pairing;
# the setup wizard writes it to config.json. Do not put it in .env in production.
# CLOUD_DEVICE_KEY=""

# ---- LAN SERVER --------------------------------------------
# Bound on 0.0.0.0 so student devices on the hall network can reach it.
PORT="4000"

# How long a student's login stays valid. Should comfortably exceed the exam duration.
STUDENT_SESSION_HOURS="6"
