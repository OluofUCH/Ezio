{
  "name": "cbt-local-server",
  "version": "0.1.0",
  "private": true,
  "description": "Offline/LAN exam server for the CBT platform — runs in an exam hall, syncs to the cloud",
  "type": "module",
  "scripts": {
    "setup": "prisma generate && tsx src/cli/migrate.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "prisma:generate": "prisma generate",
    "pull": "tsx src/cli/pull.ts",
    "push": "tsx src/cli/push.ts",
    "status": "tsx src/cli/status.ts",
    "serve": "tsx src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server/server.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@prisma/client": "^6.13.0",
    "express": "^4.21.2",
    "material-symbols": "^0.48.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.26",
    "prisma": "^6.13.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
