# ============================================================
# CBT PLATFORM — ENVIRONMENT
# Copy to `.env` and fill in. Never commit `.env`.
#
# THIS FILE IS COMMITTED (see .gitignore: `!.env.example`), so it must only ever
# contain placeholders. Never paste a real password or project ref here.
# ============================================================

# ---- DATABASE (Supabase or local Postgres) -----------------
# Supabase: use the POOLED connection (port 6543) here. The `pgbouncer=true`
# flag is required — without it Prisma's prepared statements break on the pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase: the DIRECT connection (port 5432). Prisma Migrate cannot run through
# the pooler, so `prisma migrate` uses this while the app uses DATABASE_URL.
# For a plain local Postgres, set both to the same value.
#
# Note: Supabase's `db.<ref>.supabase.co` direct host is IPv6-only. On an IPv4-only
# network, point this at the SESSION pooler (same host as above, port 5432) instead.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---- AUTH --------------------------------------------------
# Signing key for staff + student JWTs. Must be >= 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Session lifetimes. Student TTL should comfortably exceed your longest exam.
STAFF_SESSION_TTL="8h"
STUDENT_SESSION_TTL="6h"

# ---- UPLOAD LIMITS ----------------------------------------
# Max .xlsx / .csv upload size in bytes (default 2 MiB) and max parsed rows.
MAX_UPLOAD_BYTES="2097152"
MAX_IMPORT_ROWS="500"

# ---- SEED (used only by `npm run db:seed`) -----------------
SEED_SUPER_ADMIN_EMAIL="superadmin@cbt.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"
# Shared password for the demo school's admin + teacher accounts (dev seed only).
SEED_DEMO_PASSWORD="DemoPassword123!"
# Fixed deviceKey for the demo LocalServer, so `npm run smoke-sync` can authenticate
# as a device without a provisioning round trip. Dev only — real keys are issued by
# POST /api/local-servers and shown once.
SEED_DEMO_DEVICE_KEY="cbt_dev_seeddemokey0000000000000000000000000"

# ---- SMOKE TEST (used only by `npm run smoke`) -------------
SMOKE_BASE_URL="http://localhost:3000"

# ---- PROXY / RATE LIMITING --------------------------------
# Vercel terminates TLS and forwards the client address. Set to 1 there so
# login throttling keys on the real IP. Leave empty for direct/self-hosted.
TRUST_PROXY=""

# ---- MAINTENANCE CRON -------------------------------------
# Generate a random secret and configure Vercel Cron with the same value.
CRON_SECRET=""

# ---- HALL SERVER INSTALLER (optional public links) --------
# Where staff can download the Windows hall-server installer and read the setup
# guide. These are public URLs and are inlined into the browser bundle at build
# time. Leave unset to use the latest GitHub release asset for this repository.
# NEXT_PUBLIC_HALL_SERVER_DOWNLOAD_URL="https://github.com/OluofUCH/Ezio/releases/latest/download/CBT-Hall-Server-Setup-0.1.0.exe"
# NEXT_PUBLIC_HALL_SERVER_GUIDE_URL="https://github.com/OluofUCH/Ezio/blob/main/packaging/windows/README.md"
# NEXT_PUBLIC_HALL_SERVER_CHECKSUM_URL="https://github.com/OluofUCH/Ezio/releases/latest/download/SHA256SUMS.txt"
