{
  "name": "cbt-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "description": "Multi-tenant CBT platform for Nigerian secondary schools — backend API",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:sms-db": "tsx --test tests/integration/sms-foundations.test.ts",
    "test:sms-calendar": "tsx --test tests/integration/sms-calendar.test.ts",
    "test:sms-structure": "tsx --test tests/integration/sms-structure.test.ts",
    "test:sms-staff": "tsx --test tests/integration/sms-staff.test.ts",
    "test:sms-complete": "tsx --test tests/integration/sms-complete.test.ts",
    "check:lan-boundary": "node scripts/check-lan-boundary.mjs",
    "sms:backfill": "tsx scripts/backfill-sms.ts",
    "sms:backfill-results": "tsx scripts/backfill-sms-results.ts",
    "sms:inventory": "tsx scripts/inventory-sms-rollout.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke-sync": "node scripts/smoke-sync.mjs",
    "smoke-security": "node scripts/smoke-security.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.13.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.105.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "jose": "^5.9.6",
    "next": "^15.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.6.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.26",
    "prisma": "^6.13.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
